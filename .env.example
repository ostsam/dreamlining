# Application traffic uses a pooled Neon endpoint. Never expose this to a browser.
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-123456.us-east-2.aws.neon.tech/dreamlining?sslmode=require&channel_binding=require

# Migrations use the direct endpoint and a disposable, non-default Neon branch.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.c-123456.us-east-2.aws.neon.tech/dreamlining?sslmode=require&channel_binding=require
NEON_BRANCH=codex-local

APP_ORIGIN=http://localhost:3000
ADMIN_PASSWORD_HASH=scrypt$version=1$replace-with-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
CONTACT_ENCRYPTION_KEY=base64-encoded-32-byte-key
MAINTENANCE_SECRET=replace-with-at-least-32-random-bytes
